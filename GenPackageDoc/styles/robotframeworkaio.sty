\newcommand{\rcode}[1]{%
   \lstset{
      literate={
        % Per default, in LaTeX a tilde is a non-breaking space.
        % Here we redefine the tilde to be a tilde (additionally with some layout settings)
        % And we use a (masked) blank to define a fix horizontal space (that is used as blank).
        % Standard blanks are removed by LaTeX BEFORE the command is executed!
        {~}{{\raisebox{0.1ex}{\ttfamily\char`\~}}}1
        {\ }{{{\ttfamily\hspace{0.6em}}}}1
        % Alternative: A masked blank becomes a ttfamily blank (can happen that this is mapped to the 'Figure Space' character internally)
        % {\ }{{{\ttfamily\char`\ }}}1
      }
   }
   \efbox[margin=2pt,
         linewidth=1pt,
         linecolor=color_code_frame,
         backgroundcolor=color_code_background,
         font=\ttfamily\small]{\lstinline[language=Robot_code]!#1!}}


