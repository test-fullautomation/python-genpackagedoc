%
% environment for robot code listings
%
\lstdefinelanguage{Robot_code}{
      alsoletter={-,[,],{,},$,@,\%,\&},
      showstringspaces=false,
      frame=single,
      framesep=5pt,
      breaklines=true,
      breakatwhitespace=false,
      prebreak=\mbox{\textcolor{Red}{$\hookleftarrow$}\space},
      postbreak=\mbox{\textcolor{ForestGreen}{$\hookrightarrow$}\space},
      escapeinside={§}{§},
      captionpos=b,
      keywords={
         Library,
         Resource,
         Variables,
         Metadata,
         Test,
         Suite,
         Setup,
         Teardown,
         },%keywords with spaces can not be defined in keywords
      morekeywords=[1]{
         \[Documentation],
         [Tags],[Arguments],
         [Return],[Teardown],
         [Precondition],
         [Postcondition],
         [Template],
         [Timeout],
         [Return]},
      morekeywords=[2]{
         Given,
         When,
         And,
         Then,
         FOR,
         IF,
         ELSE,
         WITH,
         NAME,
         IN,
         RANGE,
         END,
         CONTINUE,
         THREAD,
      },
      morekeywords=[3]{
         PASS,
      },
      morekeywords=[4]{
         FAIL,
      },
      morekeywords=[5]{
         UNKNOWN,
      },
      keywordstyle=\color{cyan},
      keywordstyle=[1]\color{col_syntax},
      keywordstyle=[2]\color{col_robotflowcontrol},
      keywordstyle=[3]\color{col_robotmoredelim},
      keywordstyle=[4]\color{red},
      keywordstyle=[5]\color{blue},
      comment=[l][\color{col_comment}]{\#},
      commentstyle=\color{col_comment}\upshape,
      moredelim=[s][\color{col_section}]{***}{***},
      moredelim=[s][\color{col_robotmoredelim}]{$\{}{\}},
      moredelim=[s][\color{col_robotmoredelim}]{@\{}{\}},
      moredelim=[s][\color{col_robotmoredelim}]{\%\{}{\}},
      moredelim=[s][\color{col_robotmoredelim}]{\&\{}{\}},
      morestring=*[b]{"},
      % morestring=[s][\color{gray}]{<}{>},
      stringstyle=\color{red},
      identifierstyle=\color{col_robotidentifierstyle},
      rulesepcolor=\color{color_code_frame},
      rulecolor=\color{color_code_frame},
      backgroundcolor=\color{color_code_background},
      columns=fixed,
      keepspaces=true,
      abovecaptionskip=15pt
}


\lstnewenvironment{robotcode}[1][]{%
   \lstset{%
      xleftmargin=5pt,
      xrightmargin=5pt,
      basicstyle=\ttfamily\small,
      alsolanguage=Robot_code,
      #1
   }
}{}

